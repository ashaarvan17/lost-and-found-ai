NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<atlas-user>:<password>@<existing-atlas-host>/findback_ai_dev?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_32_random_bytes
RATE_LIMIT_HASH_SECRET=use_a_different_random_secret_of_at_least_32_bytes
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=0
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
AI_SERVICE_URL=http://127.0.0.1:8000/match-text
AI_SERVICE_TOKEN=generate_a_long_random_shared_secret
IMAGE_VALIDATION_URL=http://127.0.0.1:8000/validate-image
IMAGE_VALIDATION_TIMEOUT_MS=7000
PRIVATE_IMAGE_URL_TTL_SECONDS=300
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
REPORT_RATE_LIMIT_MAX=30
REPORT_RATE_LIMIT_WINDOW_MS=900000
MATCH_RATE_LIMIT_MAX=30
MATCH_RATE_LIMIT_WINDOW_MS=900000
CLAIM_RATE_LIMIT_MAX=20
CLAIM_RATE_LIMIT_WINDOW_MS=900000
RECOVERY_RATE_LIMIT_MAX=30
RECOVERY_RATE_LIMIT_WINDOW_MS=900000
ITEM_VALUE_LOW_MAX_INR=2000
ITEM_VALUE_INTERMEDIATE_MAX_INR=10000
OWNERSHIP_MAX_ATTEMPTS=3
OWNERSHIP_LOCKOUT_HOURS=24
RECOVERY_OTP_DIGITS=6
RECOVERY_OTP_VALIDITY_MINUTES=10
RECOVERY_OTP_MAX_ATTEMPTS=5
RECOVERY_OTP_LOCKOUT_MINUTES=15
RECOVERY_OTP_RESEND_COOLDOWN_SECONDS=60
RECOVERY_OTP_MAX_GENERATIONS=3
